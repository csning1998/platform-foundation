---
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
nodeRegistration:
  name: "{{ inventory_hostname }}"
  kubeletExtraArgs:
    - name: container-runtime-endpoint
      value: "{{ platform_kubeadm_cri_socket }}"
    - name: cgroup-driver
      value: "{{ platform_kubeadm_cgroup_driver }}"
    - name: node-ip
      value: "{{ platform_kubeadm_advertise_ip }}"
localAPIEndpoint:
  advertiseAddress: "{{ platform_kubeadm_advertise_ip }}"
  bindPort: 6443
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
kubernetesVersion: "{{ platform_kubeadm_version }}"
imageRepository: "{{ kubeadm_registry_vip }}/k8s-proxy"
dns:
  imageRepository: "{{ kubeadm_registry_vip }}/k8s-proxy/coredns"
controlPlaneEndpoint: "{{ platform_kubeadm_ha_vip }}:6443"
apiServer:
  certSANs:
    - "{{ platform_kubeadm_ha_vip }}"
{% for san in platform_kubeadm_extra_sans %}
    - "{{ san }}"
{% endfor %}
{% for ip in platform_kubeadm_master_ips %}
    - "{{ ip }}"
{% endfor %}

networking:
  podSubnet: "{{ platform_kubeadm_pod_subnet }}"
etcd:
  local:
    serverCertSANs:
{% for host in groups['master'] %}
      - "{{ host }}"
{% endfor %}
{% for ip in platform_kubeadm_master_ips %}
      - "{{ ip }}"
{% endfor %}
    peerCertSANs:
{% for host in groups['master'] %}
      - "{{ host }}"
{% endfor %}
{% for ip in platform_kubeadm_master_ips %}
      - "{{ ip }}"
{% endfor %}
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
serverTLSBootstrap: true
