global_defs {
    router_id {{ platform_kubeadm_keepalived_router_id }}
    vrrp_version 2
    enable_script_security
}

vrrp_instance VI_1 {
    state {{ 'MASTER' if inventory_hostname == groups['master'][0] else 'BACKUP' }}
    interface {{ platform_kubeadm_ha_interface }}
    
    virtual_router_id {{ platform_kubeadm_keepalived_vrrp_id }}
    advert_int {{ platform_kubeadm_keepalived_advert_int }}
    
    # Priority logic: The primary control plane node is assigned a priority of 100, while secondary nodes are assigned lower priorities.
    priority {{ 100 - groups['master'].index(inventory_hostname) }}
    
    virtual_ipaddress {
        {{ platform_kubeadm_ha_vip }}
    }
}