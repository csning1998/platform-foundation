---
apiVersion: kubeadm.k8s.io/v1beta4
kind: JoinConfiguration
nodeRegistration:
  name: "{{ inventory_hostname }}"
  kubeletExtraArgs:
    - name: "cgroup-driver"
      value: "{{ platform_kubeadm_k8s_cgroup_driver }}"
    - name: "node-ip"
      value: "{{ platform_kubeadm_advertise_ip }}"
discovery:
  bootstrapToken:
{% if (groups['master'] | length) > 1 %}
    apiServerEndpoint: "{{ platform_kubeadm_ha_vip }}:6443"
{% else %}
    apiServerEndpoint: "{{ hostvars[groups['master'][0]]['platform_kubeadm_advertise_ip'] }}:6443"
{% endif %}
    token: "{{ hostvars[groups['master'][0]]['platform_kubeadm_token'] }}"
    caCertHashes:
      - "sha256:{{ hostvars[groups['master'][0]]['platform_kubeadm_ca_hash'] }}"
    unsafeSkipCAVerification: {{ platform_kubeadm_k8s_join_skip_ca_verification | lower }}