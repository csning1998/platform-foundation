---
apiVersion: kubeadm.k8s.io/v1beta4
kind: JoinConfiguration
nodeRegistration:
  name: "{{ inventory_hostname }}"
  kubeletExtraArgs:
    - name: "cgroup-driver"
      value: "{{ platform_kubeadm_k8s_cgroup_driver }}"
discovery:
  bootstrapToken:
    apiServerEndpoint: "{{ platform_kubeadm_ha_vip }}:6443"
    token: "{{ hostvars[groups['master'][0]]['platform_kubeadm_token'] }}"
    caCertHashes:
      - "sha256:{{ hostvars[groups['master'][0]]['platform_kubeadm_ca_hash'] }}"
    unsafeSkipCAVerification: {{ platform_kubeadm_k8s_join_skip_ca_verification | lower }}
controlPlane:
  localAPIEndpoint:
    advertiseAddress: "{{ platform_kubeadm_advertise_ip }}"
  certificateKey: "{{ hostvars[groups['master'][0]]['platform_kubeadm_cert_key'] }}"
  imageRepository: "{{ kubeadm_image_repository }}"
  dns:
    imageRepository: "{{ kubeadm_dns_image_repository }}"
