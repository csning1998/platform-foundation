global
    log /dev/log    local0
    log /dev/log    local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    stats timeout 30s
    user haproxy
    group haproxy
    daemon

    # Tuning
    maxconn 2000
    nbthread 4
    tune.ssl.default-dh-param 2048
    tune.bufsize 16384

    # Default SSL material locations
    ca-base /etc/ssl/certs
    crt-base /etc/ssl/private

defaults
    log     global
    mode    tcp
    option  tcplog
    option  dontlognull
    maxconn 1000
    timeout connect 5000
    timeout client  60000
    timeout server  60000
    timeout http-keep-alive 10000

userlist stats_users
    user {{ platform_haproxy_stats_user }} password {{ _platform_haproxy_stats_hash.stdout }}

# Stats Interface, only bind to management IP
listen stats
    bind {{ haproxy_listen_address }}:{{ haproxy_stats_port }} ssl crt /etc/haproxy/certs/vault.pem
    mode http
{% set _metrics_sources = (platform_haproxy_metrics_source_cidrs | from_json) if platform_haproxy_metrics_source_cidrs is string else platform_haproxy_metrics_source_cidrs %}
{% if _metrics_sources | length > 0 %}
    # The observability scrapers read /metrics without the stats login, and every other path keeps the login.
    acl metrics_scraper src {{ _metrics_sources | join(' ') }}
    http-request use-service prometheus-exporter if { path /metrics } metrics_scraper
{% endif %}
    http-request auth realm HAProxy-Stats unless { http_auth(stats_users) }
    http-request use-service prometheus-exporter if { path /metrics }
    stats enable
    stats uri /
    stats refresh 10s

{# Service Port Mapping #}
{% for segment in platform_haproxy_lb_service_segments %}
# Service: {{ segment.name }}
{% if segment.ports %}
{% for port_id, port_config in segment.ports.items() %}
{% set port_id_suffix = port_id | replace('-', '_') %}
{% set backend_name = "be_" ~ (segment.name | replace('-', '_')) ~ "_" ~ port_id_suffix %}

frontend fe_{{ segment.name | replace('-', '_') }}_{{ port_id_suffix }}
    bind {{ segment.vip }}:{{ port_config.frontend_port }}
    mode tcp
    option tcplog
    default_backend {{ backend_name }}

backend {{ backend_name }}
    mode tcp
    balance roundrobin
    {% if port_config.health_check_type == 'http' %}
    option httpchk GET {{ port_config.health_check_http_path | default('/') }}
    http-check expect {{ port_config.health_check_http_expect | default('status 200') }}
    {% endif %}
    {% for server in segment.backend_servers %}
    server {{ server.name }} {{ server.ip }}:{{ port_config.backend_port }} check{% if port_config.health_check_port %} port {{ port_config.health_check_port }}{% endif %} inter {{ platform_haproxy_haproxy_health_check_inter }} fall {{ platform_haproxy_haproxy_health_check_fall }} rise {{ platform_haproxy_haproxy_health_check_rise }}{% if port_config.health_check_ssl | default(false) %} check-ssl verify required ca-file {{ platform_haproxy_haproxy_ca_path }}{% if port_config.health_check_sni %} sni str({{ port_config.health_check_sni }}){% endif %}{% endif %}{% if port_config.send_proxy_v2 | default(false) %} send-proxy-v2{% endif %}

    {% endfor %}
{% endfor %}
{% endif %}
{% endfor %}
