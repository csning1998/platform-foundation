#!/bin/bash
set -e

# The main routing table holds one route per destination prefix, insufficient when two VIPs
# on two different interfaces reply to the same external client range. Source-based routing,
# one table per VIP, keeps each reply symmetric to the interface that VIP is bound to.
{% for seg in platform_haproxy_lb_service_segments %}
ip rule del from {{ seg.vip }} table rt_{{ seg.name | replace('-', '_') }} 2>/dev/null || true
if ip link show {{ seg.interface_alias }} &>/dev/null; then
  ip rule add from {{ seg.vip }} table rt_{{ seg.name | replace('-', '_') }} priority {{ 100 + loop.index0 }}
  ip route replace {{ seg.cidr }} dev {{ seg.interface_alias }} scope link table rt_{{ seg.name | replace('-', '_') }}
  ip route replace default via {{ seg.gateway }} dev {{ seg.interface_alias }} table rt_{{ seg.name | replace('-', '_') }}
fi
{% endfor %}
