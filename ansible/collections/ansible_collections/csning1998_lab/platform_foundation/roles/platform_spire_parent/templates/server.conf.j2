server {
  bind_address = "{{ spire_parent_node_ip }}"
  bind_port    = "{{ spire_server_port }}"
  trust_domain = "{{ spire_trust_domain }}"
  # The issuer equals the discovery URL, which the JWT backend of the Downstream Vault binds as bound_issuer.
  jwt_issuer   = "https://{{ spire_parent_node_ip }}:{{ spire_oidc_discovery_port }}"
  data_dir     = "{{ utils_common_defaults_spire_dir_data }}"
  log_level    = "{{ platform_spire_parent_log_level }}"

  ca_ttl                 = "{{ platform_spire_parent_ca_ttl }}"
  default_x509_svid_ttl  = "{{ platform_spire_parent_default_svid_ttl }}"

  socket_path = "{{ utils_common_defaults_spire_dir_data }}/private/api.sock"
}

plugins {
  DataStore "sql" {
    plugin_data {
      database_type     = "sqlite3"
      connection_string = "{{ utils_common_defaults_spire_dir_data }}/datastore.sqlite3"
    }
  }

  # Attests this host only. Other consumers register with their own entries.
  NodeAttestor "join_token" {
    plugin_data {}
  }
{% set _k8s_psat_clusters = (platform_spire_parent_k8s_psat_clusters is string)
    | ternary(platform_spire_parent_k8s_psat_clusters | from_json, platform_spire_parent_k8s_psat_clusters) %}
{% if _k8s_psat_clusters | length > 0 %}

  # Attests the upstream agents of each SPIRE Child through the TokenReview API of that cluster.
  NodeAttestor "k8s_psat" {
    plugin_data {
      clusters = {
{% for cluster in _k8s_psat_clusters %}
        "{{ cluster.name }}" = {
          service_account_allow_list = {{ cluster.service_account_allow_list | to_json }}
          kube_config_file           = "{{ platform_spire_parent_k8s_psat_dir }}/{{ cluster.name }}.kubeconfig"
        }
{% endfor %}
      }
    }
  }
{% endif %}

  KeyManager "disk" {
    plugin_data {
      keys_path = "{{ utils_common_defaults_spire_dir_data }}/keys.json"
    }
  }

  UpstreamAuthority "vault" {
    plugin_data {
      vault_addr       = "{{ spire_vault_upstream_addr }}"
      pki_mount_point  = "{{ spire_vault_upstream_pki_mount_path }}"
      ca_cert_path     = "{{ platform_spire_parent_upstream_ca_cert_path }}"
      # The plugin reads the secret ID from VAULT_APPROLE_SECRET_ID, which the unit loads from a root-only file.
      approle_auth {
        approle_auth_mount_point = "{{ platform_spire_parent_upstream_approle_auth_mount_point }}"
        approle_id               = "{{ spire_vault_upstream_role_id }}"
      }
    }
  }
}
