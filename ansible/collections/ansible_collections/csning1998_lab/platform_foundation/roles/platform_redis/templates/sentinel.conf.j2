
port 0
tls-port 26379

daemonize no
loglevel notice
logfile /var/log/redis/redis-sentinel.log
pidfile /var/run/redis/redis-sentinel.pid

# Bind
bind {{ advertise_ip }} 127.0.0.1
protected-mode yes

# Systemd Integration
supervised systemd

# TLS Configuration same as Redis Server
tls-cert-file /etc/redis/certs/server.crt
tls-key-file /etc/redis/certs/server.key
tls-ca-cert-file /etc/redis/certs/ca.crt
tls-replication yes

# Monitor Configuration
sentinel monitor {{ platform_redis_sentinel_master_name }} {{ redis_initial_master_ip }} {{ redis_tls_port }} {{ sentinel_quorum }}

# Authentication
requirepass {{ redis_requirepass }}
sentinel auth-pass {{ platform_redis_sentinel_master_name }} {{ redis_requirepass }}

# Failover Timing
sentinel down-after-milliseconds {{ platform_redis_sentinel_master_name }} {{ platform_redis_sentinel_down_after_milliseconds }}
sentinel parallel-syncs {{ platform_redis_sentinel_master_name }} 1
sentinel failover-timeout {{ platform_redis_sentinel_master_name }} {{ platform_redis_sentinel_failover_timeout }}
