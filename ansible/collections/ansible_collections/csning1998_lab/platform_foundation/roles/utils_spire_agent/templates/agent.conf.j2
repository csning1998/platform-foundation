agent {
  data_dir     = "{{ utils_spire_agent_dir_data }}"
  log_level    = "{{ utils_spire_agent_log_level }}"
  server_address = "{{ utils_spire_agent_server_address }}"
  server_port    = "{{ utils_spire_agent_server_port }}"
  socket_path    = "{{ utils_spire_agent_socket_dir }}/api.sock"
  trust_domain   = "{{ spire_trust_domain }}"
  trust_bundle_path = "{{ utils_spire_agent_dir_config }}/bundle.pem"
{% if not utils_spire_agent_already_attested %}
  # Node configuration MUST supply a join token exclusively during initial node attestation
  # because subsequent agent startup authenticates via persisted SVID material.
  join_token = "{{ utils_spire_agent_join_token }}"
{% endif %}
}

plugins {
  NodeAttestor "join_token" {
    plugin_data {}
  }

  WorkloadAttestor "docker" {
    plugin_data {}
  }

  # Workload attestation MUST declare the unix plugin to validate baremetal host processes
  # by binary path and process credentials.
  WorkloadAttestor "unix" {
    plugin_data {}
  }

  KeyManager "disk" {
    plugin_data {
      directory = "{{ utils_spire_agent_dir_data }}"
    }
  }
}
