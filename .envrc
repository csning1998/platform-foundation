#!/usr/bin/env bash

# Default operator identity managing Terraform layers in this repository.
eval "$(vault-proxy-env platform-foundation)"

# Every Go client, including each Terraform provider, adds the name-constrained frontend trust anchors to the system roots.
SSL_CERT_DIR="$(expand_path terraform/layers/security-vault-downstream-pki/tls/anchors)"
export SSL_CERT_DIR
