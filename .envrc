#!/usr/bin/env bash

# Default operator identity managing Terraform layers in this repository.
# A failed vault-proxy-env exits here because direnv runs .envrc without errexit and eval of an empty string returns 0.
proxy_env="$(vault-proxy-env platform-foundation)" || exit 1
eval "${proxy_env}"
unset proxy_env

# Every Go client, including each Terraform provider, adds the name-constrained frontend trust anchors to the system roots.
SSL_CERT_DIR="$(expand_path terraform/layers/security-vault-downstream-pki/tls/anchors)"
export SSL_CERT_DIR

# Playbooks which Terraform runs from a layer directory resolve the collection of this repository through this file.
ANSIBLE_CONFIG="$(expand_path ansible/ansible.cfg)"
export ANSIBLE_CONFIG
