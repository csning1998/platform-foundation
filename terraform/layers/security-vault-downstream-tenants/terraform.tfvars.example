# One entry per tenant workload, keyed by the name below the project code, with kv_paths, kv_read_paths, and pki_roles relative to the project code.
# workload names a catalog service and component, and kubernetes names a namespace and a service account.
# issuer child binds a workload of the SPIRE Child, whose role provision-spire-child creates, and issuer parent binds one of the SPIRE Parent.
tenants = {
  "e2e-probe" = {
    issuer     = "child"
    kubernetes = { namespace = "e2e-probe", service_account = "e2e-probe" }
    kv_paths   = ["e2e-probe"]
  }

  "keycloak-frontend" = {
    issuer        = "child"
    workload      = { service = "keycloak", component = "frontend" }
    kv_read_paths = ["keycloak/frontend/app"]
    pki_roles     = ["keycloak-frontend"]
  }

  "harbor-origin-frontend" = {
    issuer        = "child"
    workload      = { service = "harbor-origin", component = "frontend" }
    kv_read_paths = ["harbor-origin/frontend/app"]
    pki_roles     = ["harbor-origin-frontend"]
  }
}
