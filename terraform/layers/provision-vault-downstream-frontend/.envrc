#!/usr/bin/env bash

# Inherits the platform-foundation Vault Proxy session and GITLAB_TERRAFORM_STATE_BASE from the repository .envrc to derive
# the GitLab HTTP state and lock endpoints of this layer.
source_up
export TF_HTTP_ADDRESS="${GITLAB_TERRAFORM_STATE_BASE:?vault-proxy-env exported no GITLAB_TERRAFORM_STATE_BASE}/provision-vault-downstream-frontend"
export TF_HTTP_LOCK_ADDRESS="${TF_HTTP_ADDRESS}/lock"
export TF_HTTP_UNLOCK_ADDRESS="${TF_HTTP_LOCK_ADDRESS}"
export TF_VAR_gitlab_terraform_state_base="${GITLAB_TERRAFORM_STATE_BASE}"
