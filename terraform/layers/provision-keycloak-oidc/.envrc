#!/usr/bin/env bash

# source_up loads the Vault Proxy session and GITLAB_TERRAFORM_STATE_BASE of the repository .envrc for the layer backend endpoints.
source_up
export TF_HTTP_ADDRESS="${GITLAB_TERRAFORM_STATE_BASE:?vault-proxy-env exported no GITLAB_TERRAFORM_STATE_BASE}/provision-keycloak-oidc"
export TF_HTTP_LOCK_ADDRESS="${TF_HTTP_ADDRESS}/lock"
export TF_HTTP_UNLOCK_ADDRESS="${TF_HTTP_LOCK_ADDRESS}"
export TF_VAR_gitlab_terraform_state_base="${GITLAB_TERRAFORM_STATE_BASE}"
